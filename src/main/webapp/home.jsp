<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMARTHIRE - Online Job Portal Management System</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
	href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap"
	rel="stylesheet">

<link rel="stylesheet"
	href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link rel="stylesheet" href="css/home.css">
</head>

<body>

	<!-- ================= NAVBAR ================= -->

	<nav class="navbar">

		<div class="container">

			<div class="logo">
				<i class="fa-solid fa-briefcase"></i> <span>SMARTHIRE</span>
			</div>

			<div class="nav-links">
				<a href="home.jsp">Home</a> <a href="login.jsp">Jobs</a> <a
					href="login.jsp">Recruiters</a> <a href="login.jsp">Login</a> <a
					href="register.jsp" class="register-btn">Register</a>
			</div>

		</div>

	</nav>

	<!-- ================= HERO ================= -->

	<section class="hero">

		<div class="container hero-container">

			<div class="hero-left">

				<span class="hero-tag"> India's Trusted Job Portal </span>

				<h1>
					Find Your Dream Job <span>Faster Than Ever</span>
				</h1>

				<p>Explore thousands of opportunities from top companies across
					India.</p>

				<div class="hero-search">

					<input type="text" placeholder="Job Title"> <input
						type="text" placeholder="Location">

					<button>
						<i class="fa-solid fa-magnifying-glass"></i> Search
					</button>

				</div>

			</div>

			<div class="hero-right">

				<div class="hero-card">

					<h3>Latest Job Opening</h3>

					<h2>Java Developer</h2>

					<p>TCS • Pune</p>

					<span>₹12 LPA</span>

				</div>

			</div>

		</div>

	</section>

	<!-- ================= COMPANIES ================= -->

	<section class="companies">

		<div class="container">

			<h2>Top Hiring Companies</h2>

			<div class="company-grid">

				<div class="company-card">TCS</div>
				<div class="company-card">Infosys</div>
				<div class="company-card">Wipro</div>
				<div class="company-card">Capgemini</div>
				<div class="company-card">Accenture</div>
				<div class="company-card">HCL</div>

			</div>

		</div>

	</section>

	<!-- ================= FEATURED JOBS ================= -->

	<section class="featured-jobs">

		<div class="container">

			<h2>Featured Jobs</h2>

			<div class="job-grid">

				<div class="job-box">

					<h3>Java Developer</h3>
					<p>TCS • Pune</p>
					<span>₹12 LPA</span> <a href="login.jsp">Apply Now</a>

				</div>

				<div class="job-box">

					<h3>React Developer</h3>
					<p>Infosys • Mumbai</p>
					<span>₹10 LPA</span> <a href="login.jsp">Apply Now</a>

				</div>

				<div class="job-box">

					<h3>Full Stack Developer</h3>
					<p>Wipro • Bangalore</p>
					<span>₹18 LPA</span> <a href="login.jsp">Apply Now</a>

				</div>

			</div>

		</div>

	</section>

	<!-- ================= FEATURES ================= -->

	<section class="features">

		<div class="container">

			<h2>Why Choose SMARTHIRE?</h2>

			<div class="feature-grid">

				<div class="feature-card">

					<i class="fa-solid fa-bolt"></i>

					<h3>Fast Apply</h3>

					<p>Apply to jobs in just one click.</p>

				</div>

				<div class="feature-card">

					<i class="fa-solid fa-shield-halved"></i>

					<h3>Secure Platform</h3>

					<p>Safe and secure user accounts.</p>

				</div>

				<div class="feature-card">

					<i class="fa-solid fa-building"></i>

					<h3>Verified Companies</h3>

					<p>Connect with trusted recruiters.</p>

				</div>

			</div>

		</div>

	</section>

	<!-- ================= STATS ================= -->

	<section class="stats">

		<div class="container stats-grid">

			<div class="stat-card">
				<h1>500+</h1>
				<p>Active Jobs</p>
			</div>

			<div class="stat-card">
				<h1>50+</h1>
				<p>Companies</p>
			</div>

			<div class="stat-card">
				<h1>200+</h1>
				<p>Recruiters</p>
			</div>

			<div class="stat-card">
				<h1>10K+</h1>
				<p>Candidates</p>
			</div>

		</div>

	</section>

	<!-- ================= CTA ================= -->

	<section class="cta">

		<div class="container">

			<h2>Ready To Start Your Career Journey?</h2>

			<a href="register.jsp"> Create Free Account </a>

		</div>

	</section>

	<!-- ================= FOOTER ================= -->

	<footer class="footer">

		<div class="container">

			<h3>SMARTHIRE</h3>

			<p>Online Job Portal Management System</p>

			<p>© 2026 All Rights Reserved</p>

		</div>

	</footer>

</body>
</html>
```
